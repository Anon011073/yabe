{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "1.0",
  "description": "A Chrome extension to manage your bookmarks on the new tab page.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "https://api.microlink.io/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  }
}